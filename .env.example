# Personal AI Brain — production-safe environment template
# Copy to .env and generate new secrets. Never commit .env.

GEMINI_API_KEY=
BRAIN_DEFAULT_MODEL=gemini-2.5-flash
BRAIN_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest
UPSTREAM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Image generation and image editing. Uses the same GEMINI_API_KEY.
# IMAGE_API_BASE_URL defaults to UPSTREAM_LLM_BASE_URL without the /openai
# suffix, because image generation uses the native generateContent endpoint.
# IMAGE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
BRAIN_IMAGE_MODEL=gemini-2.5-flash-image
BRAIN_IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image,gemini-2.0-flash-preview-image-generation
BRAIN_IMAGE_TIMEOUT_SECONDS=120
# BRAIN_GENERATED_DIR=data/storage/derived/generated

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRAIN_API_KEY=
BRAIN_API_PORT=8000
BRAIN_BIND_ADDRESS=127.0.0.1
BRAIN_STRICT_STARTUP=true

# Request ceiling per caller. Bounds damage from a leaked key or a retry loop.
BRAIN_RATE_LIMIT_ENABLED=true
BRAIN_RATE_LIMIT_REQUESTS=120
BRAIN_RATE_LIMIT_WINDOW_SECONDS=60

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SECRET_KEY=
WEBUI_NAME=Personal AI Studio
ENABLE_SIGNUP=false
DEFAULT_MODELS=personal-ai-brain
PORT=8080
WEBUI_BIND_ADDRESS=127.0.0.1

# Upload ceiling for the API (guards an internet-facing endpoint).
MAX_FILE_SIZE_BYTES=20971520

# Course corpus shipped in the repository. Separate, higher ceiling because six
# lesson PDFs exceed 20 MB. Set BRAIN_INGEST_CORPUS=false to skip background
# indexing on startup.
BRAIN_INGEST_CORPUS=true
CORPUS_MAX_FILE_SIZE_BYTES=67108864
# BRAIN_CORPUS_DIR=материалы для ии

EMBEDDING_PROVIDER_TYPE=chroma_onnx
BRAIN_DATA_DIR=data
# BRAIN_DB_PATH=data/brain.db
# VECTOR_DB_DIR=data/vector_db
