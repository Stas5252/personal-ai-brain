# Environment configuration template for Personal AI Assistant (Open WebUI)

PORT=8080
WEBUI_SECRET_KEY=change_me_to_a_secure_random_key
ENABLE_SIGNUP=true
WEBUI_NAME=Personal AI Studio
DEFAULT_MODELS=gemini-2.5-flash
OPENAI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=your_gemini_or_openai_api_key_here
