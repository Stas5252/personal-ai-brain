# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
BRAIN_API_KEY=
GEMINI_API_KEY=
# Use a model ID available to your Google account. Verify it with a real request.
BRAIN_DEFAULT_MODEL=gemini-2.5-flash
UPSTREAM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
TELEGRAM_BOT_TOKEN=
# Numeric Telegram account ID. Private chats with this owner only.
TELEGRAM_OWNER_ID=
MAX_FILE_SIZE_BYTES=20971520
EMBEDDING_PROVIDER_TYPE=chroma_onnx
# Open WebUI must use the SAME BRAIN_API_KEY (copy it locally; never commit it).
OPENAI_API_KEY=
OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1
WEBUI_SECRET_KEY=
ENABLE_SIGNUP=false
