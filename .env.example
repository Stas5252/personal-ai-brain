# Environment configuration for Personal AI Assistant & Photographer Brain Studio

# WebUI Port
PORT=8080

# Security
WEBUI_SECRET_KEY=generate_a_random_secret_key_here
ENABLE_SIGNUP=false

# Brand & Defaults
WEBUI_NAME=Personal AI Studio
DEFAULT_MODELS=personal-ai-brain

# Brain Authentication Secret
BRAIN_API_KEY=your_brain_secret_key_here

# Open WebUI Federation -> Brain OpenAI-compatible Layer
OPENAI_API_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_API_KEY=your_brain_secret_key_here

# Upstream Gemini API Key used by Brain Service
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
