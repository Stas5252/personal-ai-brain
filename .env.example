# ═══════════════════════════════════════════════════════════
# Personal AI Brain v2 — Environment Configuration
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to git (it's already in .gitignore)
# ═══════════════════════════════════════════════════════════

# ─── LLM Provider (Gemini) ────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
BRAIN_DEFAULT_MODEL=gemini-2.5-flash
UPSTREAM_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ─── Brain API Security ────────────────────────────────────────────
# Change to a random string in production!
BRAIN_API_KEY=brain-secure-stage5-federation-key-2026
BRAIN_API_PORT=8000

# ─── Telegram Bot ──────────────────────────────────────────────
# Get token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Your personal Telegram user ID (get from @userinfobot).
# Leave empty to auto-register on first message.
TELEGRAM_OWNER_ID=

# ─── Open WebUI ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=change_this_to_a_random_secret_key
WEBUI_NAME=Personal AI Studio
ENABLE_SIGNUP=false
DEFAULT_MODELS=personal-ai-brain
PORT=8080
# Docker: OPENAI_API_BASE_URL=http://brain-api:8000/v1
# Local:  OPENAI_API_BASE_URL=http://localhost:8000/v1
OPENAI_API_BASE_URL=http://brain-api:8000/v1

# ─── Limits & Embeddings ─────────────────────────────────────────
# Max file size in bytes (default: 20MB)
MAX_FILE_SIZE_BYTES=20971520
# chroma_onnx = local ONNX (no API key) | openai = text-embedding-3-small
EMBEDDING_PROVIDER_TYPE=chroma_onnx

# ─── Data Paths (optional) ─────────────────────────────────────
# BRAIN_DATA_DIR=data
